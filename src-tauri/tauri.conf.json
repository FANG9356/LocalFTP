{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocalFTP",
  "version": "0.1.0",
  "identifier": "com.localftp.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "LocalFTP",
        "width": 880,
        "height": 600,
        "minWidth": 720,
        "minHeight": 500,
        "transparent": true,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": true,
        "windowEffects": {
          "effects": ["underWindowBackground"],
          "state": "active",
          "radius": 16
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}
